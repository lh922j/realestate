# ============================================================
# 공공데이터포털 API 키 설정
# ============================================================
# 발급 방법:
#   1. https://www.data.go.kr 회원가입
#   2. 아래 두 서비스 활용신청 (무료):
#      - 국토교통부_아파트매매 실거래 상세 자료
#      - 국토교통부_아파트 전월세 자료
#   3. 마이페이지 > 인증키 관리에서 "일반 인증키(Decoding)" 복사
#      ※ "Encoding 키"가 아닌 "Decoding 키"를 사용해야 합니다

MOLIT_API_KEY=your_api_key_here

# ============================================================
# 카카오 로컬 API 키 (지오코딩용)
# ============================================================
# 발급 방법:
#   1. https://developers.kakao.com 로그인
#   2. 애플리케이션 추가 → REST API 키 복사
#   무료 한도: 일 30만 건 (수도권 아파트 단지 ~15,000개 충분)
KAKAO_API_KEY=your_kakao_rest_api_key_here

# ============================================================
# VWorld API 키 (지오코딩 대안, 선택사항)
# ============================================================
# 발급 방법: https://www.vworld.kr/dev/v4api.do
VWORLD_API_KEY=your_vworld_api_key_here

# ============================================================
# 로그 레벨 설정 (DEBUG / INFO / WARNING / ERROR)
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# 데이터 저장 경로 (기본값: ./data)
# ============================================================
DATA_DIR=./data
